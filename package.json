{
  "name": "blockade",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @blockade/db db:push",
    "db:studio": "pnpm --filter @blockade/db db:studio",
    "db:generate": "pnpm --filter @blockade/db db:generate",
    "db:migrate": "pnpm --filter @blockade/db db:migrate",
    "db:local": "pnpm --filter @blockade/db db:local",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write"
  },
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@blockade/env": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@blockade/config": "workspace:*",
    "oxlint": "^1.72.0",
    "oxfmt": "^0.57.0"
  }
}
